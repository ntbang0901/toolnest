---
import HeaderBar from "@/components/layout/header-bar.tsx";
import { tools } from "@/lib/tools-registry";

const toolIndex = tools.map(({ slug, name, description, category, keywords }) => ({
  slug,
  name,
  description,
  category,
  keywords,
}));

const currentPath = Astro.url.pathname;

// Determine current tool if on a tool page
const currentToolSlug = currentPath.match(/^\/tools\/([^/]+)/)?.[1];
const currentToolData = currentToolSlug
  ? tools.find((t) => t.slug === currentToolSlug)
  : null;
const currentTool = currentToolData
  ? { slug: currentToolData.slug, name: currentToolData.name, category: currentToolData.category }
  : null;
---

<HeaderBar
  client:load
  tools={toolIndex}
  currentPath={currentPath}
  currentTool={currentTool}
/>
